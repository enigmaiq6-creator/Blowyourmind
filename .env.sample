# Google API Key (AI Studio)
GOOGLE_API_KEY=your_key_here

# Google Cloud Vertex AI
USE_VERTEX_AI=false
GCP_PROJECT_ID=your_project_id_here
GCP_LOCATION=us-central1

# Facebook Page API Settings
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Save Reels as drafts (unpublished) on Facebook Page
SAVE_AS_DRAFT=true

# Background Stock Videos
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Text-to-Speech Settings
TTS_SPEAKING_RATE=0.92

# TTS Engine: 'true' = Google Cloud TTS, 'false' = Gemini TTS
USE_VERTEX_AI_AUDIO=true
