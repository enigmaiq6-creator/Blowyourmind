# Google API Key (AI Studio)
# You can get this from https://aistudio.google.com/
GOOGLE_API_KEY=your_key_here

# Google Cloud Vertex AI (Optional for Live Images / Animated Videos)
# Setting this to true will use Vertex AI Imagen 2 to generate 4s clips.
# Requires a GCP Project with billing and Vertex AI API enabled.
USE_VERTEX_AI=false
GCP_PROJECT_ID=your_project_id_here
GCP_LOCATION=us-central1

# Facebook Page API Settings
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Save Reels as drafts (unpublished) on Facebook Page
# Set to 'true' to save as draft in Meta Business Suite, allowing manual publishing/cross-posting to Instagram Reels.
SAVE_AS_DRAFT=true

# Image Generation Load Balancing
# VERTEX_IMAGE_RATIO: % of images sent to Vertex AI (rest goes to free alternative).
# Default 20% -> saves credits, 80% of images are free (Pollinations or Jimeng).
# Set 0 to use ONLY the free alternative, 100 for ONLY Vertex AI.
VERTEX_IMAGE_RATIO=10
#
# Free alternative Option 1: Pollinations.ai (DEFAULT - no setup required)
# 100% free, no API key, no signup. Uses FLUX model.
# Just leave JIMENG_API_KEY empty and it will use Pollinations automatically.
#
# Free alternative Option 2: Jimeng (ByteDance) via local proxy
# 1. Install proxy: git clone https://github.com/iptag/jimeng-api && cd jimeng-api && npm install && npm start
# 2. Get sessionid from https://jimeng.jianying.com/ (F12 > Application > Cookies > sessionid)
# 3. Set JIMENG_API_KEY=your_sessionid (66-80 free images/day)
# JIMENG_API_KEY=your_sessionid_here
# JIMENG_BASE_URL=http://localhost:5100/v1
